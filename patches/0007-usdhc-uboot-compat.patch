@@ -1888,15 +1890,42 @@
         s->trnmod = value & UINT16_MAX;
         break;
 
+    case SDHC_CLKCON:
+        /*
+         * U-Boot's FSL eSDHC driver programs the NXP SYSCTL layout
+         * (SDCLKFS in bits 15:8, DVS in bits 7:4) and does not set the
+         * SDHCI internal-clock-enable bits.  Translate it into the
+         * SDHCI clock state expected by the generic model.
+         */
+        s->clkcon = (value & 0xffff) |
+                    SDHC_CLOCK_INT_EN | SDHC_CLOCK_INT_STABLE |
+                    SDHC_CLOCK_SDCLK_EN;
+        s->timeoutcon = value >> 16;
+        break;
+
     case SDHC_TRNMOD:
         /*
-         * Similar to above, but this time a write to "Command
-         * Register" will be translated into a 4-byte write to
-         * "Transfer Mode register" where lower 16-bit of value would
-         * be set to zero. So what we do is fill those bits with
-         * cached value from s->trnmod and let the SDHCI
-         * infrastructure handle the rest
+         * i.MX uSDHC exposes CMD_XFR_TYP as one 32-bit register: the low
+         * 16 bits are the transfer mode and the high 16 bits are the
+         * command index/flags.  U-Boot's FSL eSDHC driver writes it with
+         * a single 32-bit store, while the generic SDHCI code only
+         * starts a command on a write to the upper command byte.
          */
+        if (size == 4) {
+            /*
+             * U-Boot places DMA enable in MIX_CTRL (bits 0 and 4) and
+             * leaves the low 16 bits of CMD_XFR_TYP at zero.  Do not
+             * overwrite the transfer mode already set by MIX_CTRL.
+             */
+            if (value & 0xffff) {
+                s->trnmod = value & 0xffff;
+            }
+            s->cmdreg = value >> 16;
+            if (sdhci_can_issue_command(s)) {
+                sdhci_send_command(s);
+            }
+            break;
+        }
         sdhci_write(opaque, offset, val | s->trnmod, size);
         break;
 
